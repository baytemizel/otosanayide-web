# Demo is an explicit local preview and never contacts the API.
# Use "live" for the real REST API; live mode refuses to start without NUXT_PUBLIC_API_ORIGIN.
NUXT_PUBLIC_APP_MODE=demo
NUXT_PUBLIC_API_ORIGIN=https://api.otosanayide.com
NUXT_PUBLIC_GOOGLE_MAPS_KEY=

# Business portal (separate project, K184), e.g. https://portal.otosanayide.com.
# Empty keeps business links passive. Must be a bare https origin.
NUXT_PUBLIC_PORTAL_ORIGIN=
# Public web origin for canonical URLs, Open Graph and sitemap.xml (e.g. https://otosanayide.com).
NUXT_PUBLIC_SITE_ORIGIN=
# Search engines are told noindex until the site is released.
NUXT_PUBLIC_INDEXING_ENABLED=false
# Legal drafts are not lawyer-approved; their page skeletons stay off.
NUXT_PUBLIC_LEGAL_PAGES_ENABLED=false

# Feature flags stay off until live acceptance.
NUXT_PUBLIC_BUSINESS_PHOTOS_ENABLED=false
NUXT_PUBLIC_BRAND_SERVING_ENABLED=false
NUXT_PUBLIC_BRAND_RECAPTCHA_SITE_KEY=

# Push and App Check have no decided target yet (see README); keep disabled.
NUXT_PUBLIC_PUSH_ENABLED=false
NUXT_PUBLIC_PUSH_VAPID_KEY=
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
