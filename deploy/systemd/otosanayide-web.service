# /etc/systemd/system/otosanayide-web.service
#
# Runs the Nuxt build (.output) behind nginx. `nuxt build` output does not read .env by
# itself, so the env file is passed here. Node must be 22.x (package.json engines);
# check the path with `which node`.

[Unit]
Description=Otosanayide web (Nuxt SSR)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/otosanayide.com
EnvironmentFile=/var/www/otosanayide.com/.env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
ExecStart=/usr/bin/node .output/server/index.mjs
Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
